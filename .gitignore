# Official bulk_extractor Windows EXE + corresponding source (fetched by
# scripts/windows/prepare-bulk-extractor.ps1). License texts are committed.
app/desktop/resources/tools/bulk_extractor/*.exe
app/desktop/resources/tools/bulk_extractor/*.tar.gz
app/desktop/resources/tools/bulk_extractor/*.tar.gz.sha256
app/desktop/resources/tools/capa/*.exe
app/desktop/resources/tools/floss/*.exe

# Same tools, Linux builds (fetched by scripts/linux/prepare-*.sh). License
# texts (README.txt/LICENSE*) are committed; the binaries and bundled shared
# libraries are not.
app/desktop/resources/tools/bulk_extractor/bulk_extractor
app/desktop/resources/tools/bulk_extractor/lib/
app/desktop/resources/tools/capa/capa
app/desktop/resources/tools/floss/floss

# Dependencies
node_modules/
app/frontend/dist/
app/frontend/node_modules/

# Rust / Tauri
app/desktop/target/
**/*.rs.bk

# Python
engine/.venv/
**/__pycache__/
**/*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Local data / evidence (never commit)
*.raw
*.dmp
*.mem
*.vmem
*.lime
*.aff4
*.e01
*.dd
data/
data/artifacts/
# runtime artifact stores (not source packages)
**/MemHunter/artifacts/
*.db
*.sqlite
*.sqlite3

# Logs / OS
*.log
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.idea/
.vscode/
*.swp

# Env / secrets
.env
.env.*
!.env.example

# Local notes
todo.txt

# Build outputs
dist/
build/
target/
app/desktop/resources/runtime/**
!app/desktop/resources/runtime/README.txt
packaging/cache/
